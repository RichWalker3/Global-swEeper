{
  "name": "global-sweep",
  "version": "0.3.0",
  "description": "Automated Website Assessment tool for Global-e merchant onboarding",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "web": "tsx src/web/server.ts",
    "start": "tsx src/web/server.ts",
    "update:github": "tsx scripts/update-from-github.ts",
    "pilot:bundle": "tsx scripts/create-pilot-bundle.ts",
    "pilot:package": "tsx scripts/package-pilot-bundle.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:unit": "vitest run --exclude 'src/smoke/**'",
    "test:smoke": "vitest run src/smoke",
    "test:coverage": "vitest run --exclude 'src/smoke/**' --coverage",
    "ci": "npm run build && npm run lint && npm run test:unit",
    "ci:full": "npm run ci && npm run test:smoke",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "playwright:install": "tsx scripts/install-playwright.ts",
    "postinstall": "npm run playwright:install"
  },
  "keywords": [
    "e-commerce",
    "website-assessment",
    "global-e",
    "playwright",
    "scraper"
  ],
  "author": "Richie Walker",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.5",
    "playwright": "1.57.0",
    "simple-wappalyzer": "^1.1.70",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0"
  }
}
